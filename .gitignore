# Environment variables
.env
.env.local

# Python runtime / virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
*.egg-info/
dist/
build/

# SQLite Databases & large binaries (uncompressed >100MB ignored, compressed <100MB tracked)
*.db
*.sqlite
*.sqlite3
*.bak
*.db.bak
gprec_knowledge.db
!gprec_knowledge.db.gz

# Data directories (preserve directory structure via .gitkeep)
data/website/*
data/pdf/*
data/notices/*
data/processed/*
data/syllabus/*
!data/website/.gitkeep
!data/pdf/.gitkeep
!data/notices/.gitkeep
!data/processed/.gitkeep
!data/syllabus/.gitkeep

# Vector store & temporary reports (uncompressed metadata >100MB ignored, compressed <100MB tracked)
vectorstore/*
!vectorstore/.gitkeep
!vectorstore/faiss_index.bin
!vectorstore/metadata.pkl.gz
reports/*
!reports/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary & Build artifacts
.pptx-build/
deliverables/
scratch/
deploy/bundle/
timetable_pdfs/


# Editor / IDE configs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

