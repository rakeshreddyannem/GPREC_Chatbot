# Streamlit Community Cloud Secrets Template
# Copy these values into your app's "Settings -> Secrets" in the Streamlit Cloud dashboard.

LLM_PROVIDER = "openrouter"

# OpenRouter Configuration
OPENROUTER_API_KEY = "your-openrouter-api-key"
OPENROUTER_MODEL = "google/gemma-2-9b-it:free"

# Google Gemini Configuration (if using LLM_PROVIDER = "gemini")
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

# Administrator Password for ?admin=1 Maintenance Panel
ADMIN_PASSWORD = "your-admin-password"
